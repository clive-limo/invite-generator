# Copy to .env.local and fill in.

# ── Database (Neon in production; docker-compose locally) ─────────────────────
# Pooled connection used by the app at runtime.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/invites"
# Direct connection used by `prisma migrate` (Neon: the non-pooled URL).
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/invites"

# ── Auth (Better Auth) ────────────────────────────────────────────────────────
# openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public base URL of the app, no trailing slash.
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional Google sign-in.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Set to "true" to show the Google button (needs the two values above).
NEXT_PUBLIC_GOOGLE_ENABLED=""

# Set to "true" to require confirming the email address before signing in.
REQUIRE_EMAIL_VERIFICATION=""

# Private beta: only the accounts in lib/beta-allowlist.ts can sign up or sign in. Add more,
# comma-separated, as full addresses or "@domain" (.env.development allows @example.com for e2e).
BETA_ALLOWLIST=""

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Leave empty in development: verification / reset links are printed to the server log.
RESEND_API_KEY=""
EMAIL_FROM="Chenah Invites <invites@example.com>"

# ── Storage (Cloudflare R2, S3-compatible API) ────────────────────────────────
# https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=""
R2_BUCKET=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# ── Misc ──────────────────────────────────────────────────────────────────────
# Keyed hash for IPs in rate limits / activity log. openssl rand -base64 32
IP_HASH_SECRET=""
# Vercel Cron sends this as a Bearer token. openssl rand -base64 32
CRON_SECRET=""
# Days of activity (submitted values) to keep.
ACTIVITY_RETENTION_DAYS="90"
